{
  "rules": {
    ".read": false,
    ".write": false,
    "check": {
      "ping": {
        ".read": true
      },
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isNumber()"
      }
    },
    "teacherList": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "gen": {
      "$sid": {
        ".read": true,
        ".write": "auth != null && root.child('teacherList').child(auth.uid).val() === true",
        ".validate": "newData.isNumber()"
      }
    },
    "accounts": {
      ".read": "auth != null && root.child('teacherList').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('teacherList').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString()"
      }
    },
    "students": {
      ".read": "auth != null && root.child('teacherList').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('teacherList').child(auth.uid).val() === true",
      "$sid": {
        "createdAt": {
          ".validate": "!data.exists() && newData.isNumber()"
        }
      }
    },
    "counters": {
      ".read": "auth != null && root.child('teacherList').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('teacherList').child(auth.uid).val() === true"
    },
    "initialPw": {
      ".read": "auth != null && root.child('teacherList').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('teacherList').child(auth.uid).val() === true",
      "$sid": {
        ".write": "auth != null && !newData.exists() && root.child('accounts').child(auth.uid).val() === $sid"
      }
    },
    "classes": {
      ".read": "auth != null && root.child('teacherList').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('teacherList').child(auth.uid).val() === true",
      "$classId": {
        ".read": "auth != null && root.child('memberOf').child(root.child('accounts').child(auth.uid).val()).child($classId).val() === true"
      }
    },
    "members": {
      ".read": "auth != null && root.child('teacherList').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('teacherList').child(auth.uid).val() === true",
      "$classId": {
        "$sid": {
          ".read": "auth != null && root.child('accounts').child(auth.uid).val() === $sid",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "memberOf": {
      ".read": "auth != null && root.child('teacherList').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('teacherList').child(auth.uid).val() === true",
      "$sid": {
        ".read": "auth != null && root.child('accounts').child(auth.uid).val() === $sid"
      }
    },
    "units": {
      ".read": "auth != null && (root.child('teacherList').child(auth.uid).val() === true || root.child('accounts').child(auth.uid).isString())",
      ".write": "auth != null && root.child('teacherList').child(auth.uid).val() === true"
    },
    "lessons": {
      ".read": "auth != null && root.child('teacherList').child(auth.uid).val() === true",
      "$classId": {
        ".read": "auth != null && (root.child('teacherList').child(auth.uid).val() === true || root.child('memberOf').child(root.child('accounts').child(auth.uid).val()).child($classId).val() === true)",
        "$lessonId": {
          ".write": "auth != null && root.child('teacherList').child(auth.uid).val() === true && (newData.exists() || !root.child('records').child($classId).child($lessonId).exists())"
        }
      }
    },
    "thumbs": {
      "$classId": {
        ".read": "auth != null && (root.child('teacherList').child(auth.uid).val() === true || root.child('memberOf').child(root.child('accounts').child(auth.uid).val()).child($classId).val() === true)",
        ".write": "auth != null && root.child('teacherList').child(auth.uid).val() === true"
      }
    },
    "records": {
      "$classId": {
        ".read": "auth != null && root.child('teacherList').child(auth.uid).val() === true",
        "$lessonId": {
          "$sid": {
            ".read": "auth != null && root.child('accounts').child(auth.uid).val() === $sid",
            ".write": "auth != null && root.child('accounts').child(auth.uid).val() === $sid && root.child('memberOf').child(root.child('accounts').child(auth.uid).val()).child($classId).val() === true && root.child('lessons').child($classId).child($lessonId).exists()",
            ".validate": "newData.hasChildren()",
            "memo": {
              ".validate": "newData.isString() && newData.val().length <= 2000"
            },
            "learned": {
              ".validate": "newData.isString() && newData.val().length <= 2000"
            },
            "question": {
              ".validate": "newData.isString() && newData.val().length <= 2000"
            },
            "level": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4 && newData.val() % 1 === 0"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "attachments": {
              ".validate": "newData.hasChildren()",
              "$aid": {
                ".validate": "$aid.matches(/^a[1-6]$/) && newData.hasChildren(['type', 'fileId', 'bytes', 'addedAt']) && (!data.exists() || newData.child('fileId').val() === data.child('fileId').val())",
                "type": {
                  ".validate": "newData.isString() && (newData.val() === 'image' || newData.val() === 'pdf')"
                },
                "fileId": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
                },
                "bytes": {
                  ".validate": "newData.isNumber() && newData.val() >= 0"
                },
                "addedAt": {
                  ".validate": "newData.isNumber()"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "inkCleared": {
              ".validate": "newData.hasChildren()",
              "$field": {
                ".validate": "($field === 'memo' || $field === 'learned' || $field === 'question' || $field.matches(/^a[1-6]$/) || root.child('lessons').child($classId).child($lessonId).child('materials').child($field).exists()) && newData.isNumber() && (!data.exists() || newData.val() > data.val()) && (!data.parent().parent().child('ink').child($field).exists() || newData.val() > data.parent().parent().child('ink').child($field).child('updatedAt').val())"
              }
            },
            "inkPagesCleared": {
              ".validate": "newData.hasChildren()",
              "$place": {
                ".validate": "newData.hasChildren()",
                "$page": {
                  ".validate": "$page.matches(/^p([1-9]|[1-9][0-9]|[1-9][0-9][0-9])$/) && ($place.matches(/^a[1-6]$/) || root.child('lessons').child($classId).child($lessonId).child('materials').child($place).exists()) && newData.isNumber() && (!data.exists() || newData.val() > data.val()) && (!data.parent().parent().parent().child('inkPages').child($place).child($page).exists() || newData.val() > data.parent().parent().parent().child('inkPages').child($place).child($page).child('updatedAt').val())"
                }
              }
            },
            "inkPages": {
              ".validate": "newData.hasChildren()",
              "$place": {
                ".validate": "newData.hasChildren()",
                "$page": {
                  ".validate": "$page.matches(/^p([1-9]|[1-9][0-9]|[1-9][0-9][0-9])$/) && (($place.matches(/^a[1-6]$/) && newData.parent().parent().parent().child('attachments').child($place).child('type').val() === 'pdf' && newData.child('on').val() === newData.parent().parent().parent().child('attachments').child($place).child('fileId').val()) || (root.child('lessons').child($classId).child($lessonId).child('materials').child($place).child('type').val() === 'pdf' && newData.child('on').val() === root.child('lessons').child($classId).child($lessonId).child('materials').child($place).child('fileId').val())) && newData.hasChildren(['fileId', 'bytes', 'strokes', 'updatedAt', 'on']) && (!data.exists() || newData.child('updatedAt').val() > data.child('updatedAt').val()) && (!data.parent().parent().parent().child('inkPagesCleared').child($place).child($page).exists() || newData.child('updatedAt').val() > data.parent().parent().parent().child('inkPagesCleared').child($place).child($page).val())",
                  "on": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200" },
                  "fileId": {
                    ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
                  },
                  "bytes": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 400000"
                  },
                  "strokes": {
                    ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 2000 && newData.val() % 1 === 0"
                  },
                  "updatedAt": {
                    ".validate": "newData.isNumber()"
                  },
                  "$other": { ".validate": false }
                }
              }
            },
            "ink": {
              ".validate": "newData.hasChildren()",
              "$field": {
                ".validate": "((($field === 'memo' || $field === 'learned' || $field === 'question') && !newData.child('on').exists()) || ($field.matches(/^a[1-6]$/) && newData.parent().parent().child('attachments').child($field).child('type').val() === 'image' && newData.child('on').val() === newData.parent().parent().child('attachments').child($field).child('fileId').val()) || (root.child('lessons').child($classId).child($lessonId).child('materials').child($field).child('type').val() === 'image' && newData.child('on').val() === root.child('lessons').child($classId).child($lessonId).child('materials').child($field).child('fileId').val())) && newData.hasChildren(['fileId', 'bytes', 'strokes', 'updatedAt']) && (!data.exists() || newData.child('updatedAt').val() > data.child('updatedAt').val()) && (!data.parent().parent().child('inkCleared').child($field).exists() || newData.child('updatedAt').val() > data.parent().parent().child('inkCleared').child($field).val())",
                "on": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200" },
                "fileId": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
                },
                "bytes": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 400000"
                },
                "strokes": {
                  ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 2000 && newData.val() % 1 === 0"
                },
                "updatedAt": {
                  ".validate": "newData.isNumber()"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "recThumbs": {
      "$classId": {
        ".read": "auth != null && root.child('teacherList').child(auth.uid).val() === true",
        "$lessonId": {
          "$sid": {
            ".read": "auth != null && root.child('accounts').child(auth.uid).val() === $sid",
            ".write": "auth != null && root.child('accounts').child(auth.uid).val() === $sid && root.child('memberOf').child(root.child('accounts').child(auth.uid).val()).child($classId).val() === true && root.child('lessons').child($classId).child($lessonId).exists()",
            ".validate": "newData.hasChildren()",
            "$aid": {
              ".validate": "$aid.matches(/^a[1-6]$/) && newData.isString() && newData.val().length <= 20000"
            }
          }
        }
      }
    },
    "inkThumbs": {
      "$classId": {
        "$lessonId": {
          "$field": {
            ".read": "auth != null && root.child('teacherList').child(auth.uid).val() === true",
            ".validate": "$field === 'learned' || $field === 'question'",
            "$sid": {
              ".read": "auth != null && root.child('accounts').child(auth.uid).val() === $sid",
              ".write": "auth != null && root.child('accounts').child(auth.uid).val() === $sid && root.child('memberOf').child(root.child('accounts').child(auth.uid).val()).child($classId).val() === true && root.child('lessons').child($classId).child($lessonId).exists()",
              ".validate": "newData.isString() && newData.val().length <= 20000"
            }
          }
        }
      }
    },
    "terms": {
      "$sid": {
        ".read": "auth != null && (root.child('teacherList').child(auth.uid).val() === true || root.child('accounts').child(auth.uid).val() === $sid)",
        "$classId": {
          ".write": "auth != null && root.child('accounts').child(auth.uid).val() === $sid && root.child('memberOf').child(root.child('accounts').child(auth.uid).val()).child($classId).val() === true",
          ".validate": "newData.hasChildren()",
          "$lessonId": {
            ".validate": "newData.hasChildren() && root.child('lessons').child($classId).child($lessonId).exists()",
            "$tid": {
              ".validate": "$tid.matches(/^t[1-8]$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
            }
          }
        }
      }
    },
    "replies": {
      "$classId": {
        ".read": "auth != null && root.child('teacherList').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('teacherList').child(auth.uid).val() === true",
        "$lessonId": {
          "$sid": {
            ".read": "auth != null && root.child('accounts').child(auth.uid).val() === $sid",
            ".validate": "newData.hasChildren(['updatedAt']) && (newData.hasChild('text') || newData.hasChild('seen'))",
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 400"
            },
            "seen": {
              ".validate": "newData.val() === true"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "aiSummaries": {
      "$classId": {
        ".read": "auth != null && root.child('teacherList').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('teacherList').child(auth.uid).val() === true",
        "$lessonId": {
          ".validate": "newData.hasChildren(['v', 'createdAt', 'overview']) && newData.child('v').val() === 1 && newData.child('createdAt').isNumber() && newData.child('overview').isString() && newData.child('overview').val().length <= 600"
        }
      }
    },
    "replyMarks": {
      "$sid": {
        ".read": "auth != null && (root.child('teacherList').child(auth.uid).val() === true || root.child('accounts').child(auth.uid).val() === $sid)",
        ".write": "auth != null && root.child('teacherList').child(auth.uid).val() === true",
        "$classId": {
          "$lessonId": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    },
    "marks": {
      "$sid": {
        ".read": "auth != null && (root.child('teacherList').child(auth.uid).val() === true || root.child('accounts').child(auth.uid).val() === $sid)",
        "$classId": {
          ".write": "auth != null && root.child('accounts').child(auth.uid).val() === $sid && root.child('memberOf').child(root.child('accounts').child(auth.uid).val()).child($classId).val() === true",
          ".validate": "newData.hasChildren()",
          "$lessonId": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4 && newData.val() % 1 === 0"
          }
        }
      }
    },
    "rika": {
      "classUnit": {
        ".read": "auth != null && root.child('teacherList').child(auth.uid).val() === true",
        "$classId": {
          ".read": "auth != null && (root.child('teacherList').child(auth.uid).val() === true || root.child('memberOf').child(root.child('accounts').child(auth.uid).val()).child($classId).val() === true)",
          ".write": "auth != null && root.child('teacherList').child(auth.uid).val() === true && (!newData.exists() || root.child('classes').child($classId).exists())",
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{1,40}$/)"
        }
      },
      "state": {
        ".read": "auth != null && root.child('teacherList').child(auth.uid).val() === true",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && ((auth.uid === $uid && (root.child('teacherList').child(auth.uid).val() === true || root.child('accounts').child(auth.uid).isString())) || (root.child('teacherList').child(auth.uid).val() === true && !newData.exists()))",
          ".validate": "newData.hasChildren(['v', 'updatedAt', 'json']) && (!data.exists() || (newData.child('base').val() === data.child('updatedAt').val() && newData.child('updatedAt').val() > data.child('updatedAt').val()))",
          "v": { ".validate": "newData.val() === 1" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "json": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 500000" },
          "base": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "log": {
        ".read": "auth != null && root.child('teacherList').child(auth.uid).val() === true",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && root.child('teacherList').child(auth.uid).val() === true && !newData.exists()",
          "$chunk": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && (root.child('teacherList').child(auth.uid).val() === true || root.child('accounts').child(auth.uid).isString())",
            ".validate": "$chunk.matches(/^[A-Za-z0-9_-]{8,40}$/) && newData.isString() && newData.val().length >= 2 && newData.val().length <= 200000"
          }
        }
      }
    }
  }
}
